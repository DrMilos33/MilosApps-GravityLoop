{
  "name": "milosapps-gravity-loop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "pnpm build:production",
    "build:production": "tsc -b && vite build --base ./ && node tests/stamp-production-artifact.mjs && node tests/verify-built-essentials.mjs && node tests/verify-production-artifact.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "verify:shell": "node vendor/milosapps-shell/v2/verify.mjs --app-root . --manifest milos-app.json",
    "verify:essentials": "node vendor/milosapps-essentials/v1/verify.mjs --app-root . --manifest milos-essentials.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:dev": "playwright test --config playwright.dev.config.ts",
    "test:e2e:production": "playwright test --config playwright.production.config.ts",
    "test:e2e:headed": "playwright test --headed",
    "test:all": "pnpm verify:shell && pnpm verify:essentials && pnpm test && pnpm build:production && pnpm test:e2e",
    "qa:perf": "playwright test tests/e2e/performance.spec.ts --project=chromium"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.0",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
